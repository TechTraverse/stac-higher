{
  "$comment": "Golden fixtures for the \u00a75.1 ingest config cross-runtime contract (ISSUE I-53). Consumed by app/src/__tests__/contract-fixtures.test.ts (Zod, the strict write gatekeeper) and services/pipeline/tests/test_contract_fixtures.py (lenient reader that re-applies defaults). See README.md for the format and the accept/reject semantics. `settle` (G-3) decides when a discovered file becomes eligible for FETCH; `auto` resolves against the connection protocol in the pipeline's effective_settle(). W-1 adds `window` (begin/end: RFC3339 or -<n>[smhd]), `path_template` ({Y}{m}{d}{j}{H} prefix expansion, needs a window) and `max_files_per_poll` \u2014 all optional; Zod checks their SHAPE, the pipeline checks the bound GRAMMAR, which is why an unparseable bound is app-accept / pipeline-reject.",
  "minimal": {
    "source_path": "/out"
  },
  "defaults": {
    "source_path": "/out",
    "include": [],
    "exclude": [],
    "poll_frequency_seconds": 300,
    "settle": "auto",
    "storage_mode": "copy",
    "grouping": {
      "rule": "none",
      "timeout_seconds": 900,
      "on_timeout": "ingest_partial"
    },
    "metadata": {
      "strategy": "raster_auto",
      "defaults": {}
    },
    "post_ingest": "leave"
  },
  "cases": [
    {
      "name": "minimal",
      "config": {
        "source_path": "/out"
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "defaults-applied (what the app writes for the minimal doc)",
      "config": {
        "source_path": "/out",
        "include": [],
        "exclude": [],
        "poll_frequency_seconds": 300,
        "storage_mode": "copy",
        "grouping": {
          "rule": "none",
          "timeout_seconds": 900,
          "on_timeout": "ingest_partial"
        },
        "metadata": {
          "strategy": "raster_auto",
          "defaults": {}
        },
        "post_ingest": "leave"
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "full-featured",
      "config": {
        "source_path": "/data/out",
        "include": [
          "**/*.tif"
        ],
        "exclude": [
          "**/*.tmp"
        ],
        "poll_frequency_seconds": 600,
        "storage_mode": "copy",
        "grouping": {
          "rule": "shared_basename",
          "timeout_seconds": 300,
          "on_timeout": "discard"
        },
        "metadata": {
          "strategy": "sidecar",
          "sidecar": {
            "pattern": "{basename}.xml",
            "parser": "generic_xml"
          },
          "defaults": {
            "datetime": "2026-01-01T00:00:00Z"
          }
        },
        "post_ingest": "move:/archive"
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "reference mode with post_ingest leave",
      "config": {
        "source_path": "/out",
        "storage_mode": "reference",
        "post_ingest": "leave"
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "empty document (missing source_path)",
      "config": {},
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "empty source_path",
      "config": {
        "source_path": ""
      },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "whitespace-only source_path",
      "config": {
        "source_path": "   "
      },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "unknown grouping rule",
      "config": {
        "source_path": "/out",
        "grouping": {
          "rule": "bogus"
        }
      },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "unknown grouping on_timeout",
      "config": {
        "source_path": "/out",
        "grouping": {
          "on_timeout": "explode"
        }
      },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "unknown storage_mode",
      "config": {
        "source_path": "/out",
        "storage_mode": "s3"
      },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "include is not an array",
      "config": {
        "source_path": "/out",
        "include": "*.tif"
      },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "unknown top-level key (writer strict, reader lenient)",
      "config": {
        "source_path": "/out",
        "bogus": true
      },
      "app": "reject",
      "pipeline": "accept"
    },
    {
      "name": "poll below the 60s floor (writer-only constraint)",
      "config": {
        "source_path": "/out",
        "poll_frequency_seconds": 30
      },
      "app": "reject",
      "pipeline": "accept"
    },
    {
      "name": "reference mode with post_ingest delete (writer-only cross-field rule)",
      "config": {
        "source_path": "/out",
        "storage_mode": "reference",
        "post_ingest": "delete"
      },
      "app": "reject",
      "pipeline": "accept"
    },
    {
      "name": "malformed post_ingest (writer validates the shape; reader carries it through)",
      "config": {
        "source_path": "/out",
        "post_ingest": "shred"
      },
      "app": "reject",
      "pipeline": "accept"
    },
    {
      "name": "grouping timeout as a numeric string (writer typed; reader coerces)",
      "config": {
        "source_path": "/out",
        "grouping": {
          "timeout_seconds": "900"
        }
      },
      "app": "reject",
      "pipeline": "accept"
    },
    {
      "name": "settle immediate (s3 keys are atomically visible)",
      "config": {
        "source_path": "/out",
        "settle": "immediate"
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "settle two_polls forced on any protocol",
      "config": {
        "source_path": "/out",
        "settle": "two_polls"
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "unknown settle mode",
      "config": {
        "source_path": "/out",
        "settle": "sometimes"
      },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "rolling window, open end",
      "config": {
        "source_path": "/out",
        "window": {
          "begin": "-6h"
        }
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "absolute backfill window",
      "config": {
        "source_path": "/out",
        "window": {
          "begin": "2026-08-01T00:00:00Z",
          "end": "2026-08-02T00:00:00Z"
        }
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "window with a lagging end (skip partially-landed objects)",
      "config": {
        "source_path": "/out",
        "window": {
          "begin": "-2h",
          "end": "-10m"
        }
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "window.end without begin",
      "config": {
        "source_path": "/out",
        "window": {
          "end": "-10m"
        }
      },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "unparseable bound",
      "config": {
        "source_path": "/out",
        "window": {
          "begin": "yesterday"
        }
      },
      "app": "accept",
      "pipeline": "reject"
    },
    {
      "name": "path_template with a window",
      "config": {
        "source_path": "ABI-L2-MCMIPC/",
        "path_template": "{Y}/{j}/{H}/",
        "window": {
          "begin": "-6h"
        }
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "path_template without a window has nothing to expand",
      "config": {
        "source_path": "/out",
        "path_template": "{Y}/{j}/"
      },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "path_template with no date token",
      "config": {
        "source_path": "/out",
        "path_template": "static/",
        "window": {
          "begin": "-6h"
        }
      },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "path_template with an unknown token",
      "config": {
        "source_path": "/out",
        "path_template": "{Y}/{doy}/",
        "window": {
          "begin": "-6h"
        }
      },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "per-poll cap",
      "config": {
        "source_path": "/out",
        "max_files_per_poll": 200
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "per-poll cap below one",
      "config": {
        "source_path": "/out",
        "max_files_per_poll": 0
      },
      "app": "reject",
      "pipeline": "reject"
    }
  ]
}
