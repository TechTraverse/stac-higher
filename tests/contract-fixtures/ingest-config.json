{
  "$comment": "Golden fixtures for the §5.1 ingest config cross-runtime contract (ISSUE I-53). Consumed by app/src/__tests__/contract-fixtures.test.ts (Zod, the strict write gatekeeper) and services/pipeline/tests/test_contract_fixtures.py (lenient reader that re-applies defaults). See README.md for the format and the accept/reject semantics.",
  "minimal": { "source_path": "/out" },
  "defaults": {
    "source_path": "/out",
    "include": [],
    "exclude": [],
    "poll_frequency_seconds": 300,
    "storage_mode": "copy",
    "grouping": {
      "rule": "none",
      "timeout_seconds": 900,
      "on_timeout": "ingest_partial"
    },
    "metadata": {
      "strategy": "raster_auto",
      "defaults": {}
    },
    "post_ingest": "leave"
  },
  "cases": [
    {
      "name": "minimal",
      "config": { "source_path": "/out" },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "defaults-applied (what the app writes for the minimal doc)",
      "config": {
        "source_path": "/out",
        "include": [],
        "exclude": [],
        "poll_frequency_seconds": 300,
        "storage_mode": "copy",
        "grouping": {
          "rule": "none",
          "timeout_seconds": 900,
          "on_timeout": "ingest_partial"
        },
        "metadata": { "strategy": "raster_auto", "defaults": {} },
        "post_ingest": "leave"
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "full-featured",
      "config": {
        "source_path": "/data/out",
        "include": ["**/*.tif"],
        "exclude": ["**/*.tmp"],
        "poll_frequency_seconds": 600,
        "storage_mode": "copy",
        "grouping": {
          "rule": "shared_basename",
          "timeout_seconds": 300,
          "on_timeout": "discard"
        },
        "metadata": {
          "strategy": "sidecar",
          "sidecar": { "pattern": "{basename}.xml", "parser": "generic_xml" },
          "defaults": { "datetime": "2026-01-01T00:00:00Z" }
        },
        "post_ingest": "move:/archive"
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "reference mode with post_ingest leave",
      "config": {
        "source_path": "/out",
        "storage_mode": "reference",
        "post_ingest": "leave"
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "empty document (missing source_path)",
      "config": {},
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "empty source_path",
      "config": { "source_path": "" },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "whitespace-only source_path",
      "config": { "source_path": "   " },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "unknown grouping rule",
      "config": { "source_path": "/out", "grouping": { "rule": "bogus" } },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "unknown grouping on_timeout",
      "config": { "source_path": "/out", "grouping": { "on_timeout": "explode" } },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "unknown storage_mode",
      "config": { "source_path": "/out", "storage_mode": "s3" },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "include is not an array",
      "config": { "source_path": "/out", "include": "*.tif" },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "unknown top-level key (writer strict, reader lenient)",
      "config": { "source_path": "/out", "bogus": true },
      "app": "reject",
      "pipeline": "accept"
    },
    {
      "name": "poll below the 60s floor (writer-only constraint)",
      "config": { "source_path": "/out", "poll_frequency_seconds": 30 },
      "app": "reject",
      "pipeline": "accept"
    },
    {
      "name": "reference mode with post_ingest delete (writer-only cross-field rule)",
      "config": {
        "source_path": "/out",
        "storage_mode": "reference",
        "post_ingest": "delete"
      },
      "app": "reject",
      "pipeline": "accept"
    },
    {
      "name": "malformed post_ingest (writer validates the shape; reader carries it through)",
      "config": { "source_path": "/out", "post_ingest": "shred" },
      "app": "reject",
      "pipeline": "accept"
    },
    {
      "name": "grouping timeout as a numeric string (writer typed; reader coerces)",
      "config": { "source_path": "/out", "grouping": { "timeout_seconds": "900" } },
      "app": "reject",
      "pipeline": "accept"
    }
  ]
}
