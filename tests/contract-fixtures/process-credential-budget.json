{
  "$comment": "K-4 (#12, spec §5.4): the mint counts max_queue_wait_seconds + timeout_seconds + grace (STS minimum 900), the same sum the app's deploy gate checks, so deploy_allowed and mint_allowed agree on every case; over the cap the mint refuses, never clamps.",
  "setting": "PROCESS_MAX_CREDENTIAL_SECONDS",
  "unset_means": "no limit",
  "grace_setting": "PROCESS_CREDENTIAL_GRACE_SECONDS",
  "grace_default_seconds": 300,
  "deploy_refusal": { "status": 422, "code": "credential_budget_exceeded" },
  "mint_refusal": { "error": "credential_budget_exceeded" },
  "cases": [
    { "name": "at budget", "max_credential_seconds": 3600, "max_queue_wait_seconds": 600, "timeout_seconds": 2700, "grace_seconds": 300, "deploy_allowed": true, "mint_allowed": true },
    { "name": "one over", "max_credential_seconds": 3600, "max_queue_wait_seconds": 600, "timeout_seconds": 2701, "grace_seconds": 300, "deploy_allowed": false, "mint_allowed": false },
    { "name": "mint over", "max_credential_seconds": 3600, "max_queue_wait_seconds": 0, "timeout_seconds": 3301, "grace_seconds": 300, "deploy_allowed": false, "mint_allowed": false },
    { "name": "unset", "max_credential_seconds": null, "max_queue_wait_seconds": 0, "timeout_seconds": 86400, "grace_seconds": 300, "deploy_allowed": true, "mint_allowed": true }
  ],
  "cap_min_seconds": 900,
  "parse_cases": [
    { "name": "cap unset", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": null, "result": null },
    { "name": "cap blank", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": "", "result": null },
    { "name": "cap whitespace", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": "  ", "result": null },
    { "name": "cap valid", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": "3600", "result": 3600 },
    { "name": "cap padded", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": " 3600 ", "result": 3600 },
    { "name": "cap at the STS minimum", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": "900", "result": 900 },
    { "name": "cap below the STS minimum", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": "899", "result": "reject" },
    { "name": "cap zero", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": "0", "result": "reject" },
    { "name": "cap plus sign", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": "+3600", "result": "reject" },
    { "name": "cap negative", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": "-3600", "result": "reject" },
    { "name": "cap non-numeric", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": "1h", "result": "reject" },
    { "name": "cap decimal", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": "3600.5", "result": "reject" },
    { "name": "cap underscore separator", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": "3_600", "result": "reject" },
    { "name": "cap exponent", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": "1e4", "result": "reject" },
    { "name": "cap non-ASCII digits", "variable": "PROCESS_MAX_CREDENTIAL_SECONDS", "raw": "٣٦٠٠", "result": "reject" },
    { "name": "grace unset", "variable": "PROCESS_CREDENTIAL_GRACE_SECONDS", "raw": null, "result": 300 },
    { "name": "grace blank", "variable": "PROCESS_CREDENTIAL_GRACE_SECONDS", "raw": "", "result": 300 },
    { "name": "grace whitespace", "variable": "PROCESS_CREDENTIAL_GRACE_SECONDS", "raw": "  ", "result": 300 },
    { "name": "grace valid", "variable": "PROCESS_CREDENTIAL_GRACE_SECONDS", "raw": "120", "result": 120 },
    { "name": "grace padded", "variable": "PROCESS_CREDENTIAL_GRACE_SECONDS", "raw": " 120 ", "result": 120 },
    { "name": "grace zero", "variable": "PROCESS_CREDENTIAL_GRACE_SECONDS", "raw": "0", "result": 0 },
    { "name": "grace plus sign", "variable": "PROCESS_CREDENTIAL_GRACE_SECONDS", "raw": "+300", "result": "reject" },
    { "name": "grace negative", "variable": "PROCESS_CREDENTIAL_GRACE_SECONDS", "raw": "-60", "result": "reject" },
    { "name": "grace non-numeric", "variable": "PROCESS_CREDENTIAL_GRACE_SECONDS", "raw": "five", "result": "reject" },
    { "name": "grace decimal", "variable": "PROCESS_CREDENTIAL_GRACE_SECONDS", "raw": "300.0", "result": "reject" },
    { "name": "grace underscore separator", "variable": "PROCESS_CREDENTIAL_GRACE_SECONDS", "raw": "3_00", "result": "reject" },
    { "name": "grace non-ASCII digits", "variable": "PROCESS_CREDENTIAL_GRACE_SECONDS", "raw": "٣٠٠", "result": "reject" }
  ]
}
