{
  "$comment": "Golden fixture for the §5.1 ingest expectation shape (M2-A). Consumed by app/src/__tests__/contract-fixtures.test.ts (ingestExpectationSchema) and services/pipeline/tests/test_contract_fixtures.py (parse_ingest_expectation). Zod is the strict write gatekeeper; the Python parser is a lenient reader that ignores unknown keys.",
  "minimal": { "expect_activity_within_seconds": 3600 },
  "defaults": { "expect_activity_within_seconds": 3600 },
  "cases": [
    {
      "name": "one-second floor is valid",
      "config": { "expect_activity_within_seconds": 1 },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "zero window",
      "config": { "expect_activity_within_seconds": 0 },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "negative window",
      "config": { "expect_activity_within_seconds": -60 },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "non-numeric window",
      "config": { "expect_activity_within_seconds": "soon" },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "boolean window",
      "config": { "expect_activity_within_seconds": true },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "fractional seconds (writer requires an int; reader truncates)",
      "config": { "expect_activity_within_seconds": 3600.5 },
      "app": "reject",
      "pipeline": "accept"
    },
    {
      "name": "unknown key alongside the window",
      "config": { "expect_activity_within_seconds": 3600, "extra": 1 },
      "app": "reject",
      "pipeline": "accept"
    },
    {
      "name": "delivery key on an ingest association",
      "config": { "deliver_within_seconds": 30 },
      "app": "reject",
      "pipeline": "accept"
    },
    {
      "name": "empty object (a declared expectation must declare a window)",
      "config": {},
      "app": "reject",
      "pipeline": "accept"
    }
  ]
}
