      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "zero timeout",
      "config": { "kind": "inline_python", "timeout_seconds": 0 },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "non-numeric timeout",
      "config": { "kind": "inline_python", "timeout_seconds": "15m" },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "boolean memory",
      "config": { "kind": "inline_python", "memory_mb": true },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "retry with an unknown backoff",
      "config": { "kind": "inline_python", "retry": { "backoff": "fibonacci" } },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "retry with zero attempts (a run must be attempted once)",
