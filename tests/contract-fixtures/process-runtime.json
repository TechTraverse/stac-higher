      "minimal": { "kind": "inline_python" },
      "defaults": {
        "kind": "inline_python",
        "image": null,
        "memory_mb": 512,
        "timeout_seconds": 900,
        "retry": { "max_attempts": 3, "backoff": "exponential" },
        "network": { "level": "isolated", "hosts": [] },
        "runtime_image": "default"
      }
    },
    "container": {
      "minimal": { "kind": "container", "image": "ghcr.io/example/proc:1.2.3" },
