      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "retry as the wrong container type",
      "config": { "kind": "inline_python", "retry": [] },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "inline_python carrying an image (nothing to run it in)",
