{
  "style": "discriminated-union",
  "$comment": "Golden fixture for the §5.6 process `runtime` shape (Phase 9 / M5-0), stored in stac_higher.process_revisions.runtime. Consumed by app/src/__tests__/contract-fixtures.test.ts (processRuntimeSchema) and services/pipeline/tests/test_contract_fixtures.py (parse_process_runtime). THE SLICE-1 ASYMMETRY IS DELIBERATE AND PINNED HERE: the shape CARRIES the `container` arm so nothing is foreclosed, and the pipeline reader accepts it, while the app's write gate REJECTS it — user-supplied images are a supply-chain review surface that stays out of the first accreditation scope (spec §4). Every `container` case below is therefore app: reject / pipeline: accept. `memory_mb` and `timeout_seconds` become the executor's per-run HostConfig limits and wall-clock kill (ADR 0013); `retry` reuses the queue RetrySpec shape from §5.1's delivery config verbatim.",
  "discriminator": "kind",
  "variants": {
    "inline_python": {
      "minimal": { "kind": "inline_python" },
      "defaults": {
        "kind": "inline_python",
        "image": null,
        "memory_mb": 512,
        "timeout_seconds": 900,
        "retry": { "max_attempts": 3, "backoff": "exponential" }
      }
    },
    "container": {
      "minimal": { "kind": "container", "image": "ghcr.io/example/proc:1.2.3" },
      "defaults": {
        "kind": "container",
        "image": "ghcr.io/example/proc:1.2.3",
        "memory_mb": 512,
        "timeout_seconds": 900,
        "retry": { "max_attempts": 3, "backoff": "exponential" }
      }
    }
  },
  "cases": [
    {
      "name": "inline_python with every knob set",
      "config": {
        "kind": "inline_python",
        "image": null,
        "memory_mb": 2048,
        "timeout_seconds": 60,
        "retry": { "max_attempts": 1, "backoff": "fixed" }
      },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "inline_python at the memory floor",
      "config": { "kind": "inline_python", "memory_mb": 128 },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "memory below the floor (a run needs room for the interpreter)",
      "config": { "kind": "inline_python", "memory_mb": 127 },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "zero memory",
      "config": { "kind": "inline_python", "memory_mb": 0 },
      "app": "reject",
      "pipeline": "reject"
    },
    {
      "name": "fractional memory (writer requires an int; reader truncates)",
      "config": { "kind": "inline_python", "memory_mb": 512.5 },
      "app": "reject",
      "pipeline": "accept"
    },
    {
      "name": "timeout at the one-second floor",
      "config": { "kind": "inline_python", "timeout_seconds": 1 },
      "app": "accept",
      "pipeline": "accept"
    },
    {
      "name": "timeout above the ceiling (a run is not a service)",
