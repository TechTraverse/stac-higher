{
  "name": "stac-higher",
  "private": true,
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "verify": "npm run check --workspace app && npm run build --workspace app && npm run test --workspace app",
    "db:migrate": "tsx scripts/apply-app-migrations.ts",
    "test:integration": "node --test \"tests/integration/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "tsx": "4.23.13"
  }
}
