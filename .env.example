# Example environment for local dev. Copy to `.env` and adjust.
# `.env` is gitignored; this example is committed.

# --- Credentials envelope (Phase 2) ---
# REQUIRED. 32 random bytes in STANDARD base64 (not base64url: the pipeline
# rejects it), SHARED by the app and the pipeline. Generate your own, per
# stack; never reuse someone else's:
#   openssl rand -base64 32
# Compose passes it to the pipeline; the app needs it in the shell that runs
# `npm run dev`. Changing it later orphans every stored credential. Full
# reference: docs/connections.md, "The master key".
CREDENTIALS_MASTER_KEY=

# Hosts the APP's safeFetch may reach although they resolve to loopback. Dev
# needs localhost for the local catalog, or creating a collection 403s. Read
# from the app's shell, like the key above.
SAFE_FETCH_ALLOW_HOSTS=localhost,127.0.0.1

# Egress allowlist for the pipeline SSRF guard: hosts permitted even when they
# resolve to private/compose-internal addresses (the throwaway test servers +
# MinIO). Consumed by the pipeline service.
EGRESS_ALLOW_HOSTS=minio,sftp-test,ftp-test,ftps-test

# --- App object storage / asset service (Phase 3) ---
# The app only PRESIGNS (offline) — the endpoint must be reachable by the
# BROWSER that uses the URL. On the host, localhost:9000 works for both. Inside
# compose, set a browser-reachable host (never http://minio:9000).
# Defaults below match the compose MinIO, so these are optional locally.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=stac-higher
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true

# --- Bearer-token API auth (Phase 7 push ingest; docs/auth.md) ---
# Comma-separated `aud` values accepted on `Authorization: Bearer <JWT>`
# requests to /api/* in oidc mode — mirrors the auth proxy's
# ALLOWED_JWT_AUDIENCES. Default matches the realm's audience mapper.
# AUTH_BEARER_AUDIENCES=stac-higher

# --- BFF shared secret (Phase 7 §4.3/§5.2, ADR 0015) ---
# When set, the app stamps `X-BFF-Auth: <secret>` on every catalog write it
# forwards (/api/catalog/*), and the auth-enforced proxy policy exempts those
# app-mediated writes from the externally_writable gate. Unset in dev
# (pass-through proxy ignores it); MANDATORY in the auth-enforced overlay,
# where compose's required-variable interpolation is the fail-fast for the
# proxy service, and the proxy-policy factory refuses to start without it.
# The APP deliberately does NOT fail fast — it cannot tell "dev without a
# secret" from "enforced overlay without one" (app/src/lib/push/config.ts)
# — so give the app process the same value here or in the shell, or its
# writes lose the exemption. Shared between the app and proxy env only —
# never reachable by clients. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# CATALOG_BFF_SHARED_SECRET=

# --- OGC serving links (pre-M5 hardening; docs/serving.md) ---
# Browser-facing base URLs the Settings tab's serving panel links to.
# Defaults match the compose services; override for a deployment.
# PUBLIC_TITILER_URL=http://localhost:8084
# PUBLIC_TIPG_URL=http://localhost:8085

# --- Process executor (Phase 9 M5-B; ADR 0013) ---
# The pipeline launches process runs as SIBLING containers through a
# least-privilege socket proxy. DOCKER_HOST must point at the proxy — the
# executor's startup self-check REFUSES a unix:// socket, so mounting the raw
# daemon socket fails loudly instead of quietly working.
# DOCKER_HOST=tcp://docker-socket-proxy:2375
# PROCESS_RUNTIME_IMAGE=stac-higher-process-runtime:local
# The stactools variant behind `runtime.runtime_image: "stactools"` (X-3).
# Empty means "no such image here": a run asking for it dies by name.
# PROCESS_RUNTIME_IMAGE_STACTOOLS=stac-higher-process-runtime-stactools:local
# The deployment's hardware-profile document (K-1). Unset means the repo
# checkout's infra/hardware-profiles/local.json; both images copy that file
# to this path through the `hardware` build context.
# PROCESS_HARDWARE_PROFILES_FILE=
# The deployment's image policy for user-supplied process images (C-1).
# Unset means the repo checkout's infra/image-policy/default.json; both
# images copy that file to this path through the `imagepolicy` build context.
# PROCESS_IMAGE_POLICY_FILE=
# The image scanner (C-2): its image (built by `docker buildx bake -f
# services/process-runtime/docker-bake.hcl image-scanner`), its network
# (compose: the egress-capable `stac-higher_scanner-egress`; the CODE default
# `none` makes every scan fail), whether it refreshes the Grype DB at scan
# start (false for air-gap), the DB mirror, and scans at once.
# IMAGE_SCANNER_IMAGE=stac-higher-image-scanner:local
# PROCESS_SCANNER_NETWORK=stac-higher_scanner-egress
# IMAGE_SCANNER_DB_UPDATE=true
# GRYPE_DB_UPDATE_URL=
# IMAGE_SCAN_CONCURRENCY=1
# Optional Docker Hub credential for docker.io images without a group
# credential; unset = anonymous pulls (ISSUES I-125).
# REGISTRY_DOCKERHUB_USER=
# REGISTRY_DOCKERHUB_TOKEN=
# Network for run containers. The CODE default is `none` (no network at all),
# right for a process that only transforms metadata. A process that PUBLISHES
# must reach object storage, so compose defaults this to the internal
# `stac-higher_process-runs` network, which has MinIO attached and nothing
# else — no database, no catalog API, and not the socket proxy that launches
# runs. `internal: true` means no route off the host either.
# PROCESS_NETWORK=stac-higher_process-runs
# PROCESS_LOG_MAX_BYTES=10485760
# Run credentials live for the run's timeout plus this grace window.
# PROCESS_CREDENTIAL_GRACE_SECONDS=300
# Role the run's STS session is derived from. MinIO accepts any ARN; AWS
# deployments set the real one. There is NO fallback to the platform's own
# keys — an object store without STS cannot run processes.
# PROCESS_STS_ROLE_ARN=arn:aws:iam::000000000000:role/stac-higher-process-run
# PROCESS_RUN_S3_ENDPOINT=http://minio:9000
# A run still `running` after this is presumed crashed and requeued (M5-C).
# PROCESS_RUN_STALL_SECONDS=3600
# How long the daily flow-stats history is kept (M5-E, P9-E: ~400 days so a
# year-over-year comparison always has a full prior year).
# FLOW_STATS_RETENTION_DAYS=400

# --- Pipeline platform storage / staging cleanup (Phase 3) ---
# The pipeline runs inside compose and reaches MinIO at http://minio:9000.
# Defaults match compose; override for a cloud deployment.
# STAGING_S3_ENDPOINT=http://minio:9000
# STAGING_S3_ACCESS_KEY_ID=minioadmin
# STAGING_S3_SECRET_ACCESS_KEY=minioadmin
# STAGING_BUCKET=stac-higher
# STAGING_TTL_SECONDS=86400
