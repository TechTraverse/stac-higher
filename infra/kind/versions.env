# The kind CI leg's pins (K-6, plan K6-R2). Sourced by scripts/kind-up.sh and
# .github/workflows/kind.yml; parsed by test_kueue_manifests.py.
# - kind >= v0.24.0: its default CNI (kindnetd) enforces NetworkPolicy
#   (kind v0.24.0 release notes; K6-R20).
# - The node image MUST be pinned by digest (kind's release notes); it runs
#   Kubernetes 1.34, the chart's floor (scripts/check-helm.sh) and Kueue's.
# - kubectl matches the node's patch, inside the version-skew policy.
# Checksums: kind-linux-amd64 (the release's .sha256sum) and kubectl
# linux/amd64 (dl.k8s.io's .sha256).
KIND_VERSION=v0.33.0
KIND_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_NODE_IMAGE=kindest/node:v1.34.11@sha256:44e222ee2132dab25ff87301682f89eb82c7880ea3a1bf543bfe9708fd08d67d
KUBECTL_VERSION=v1.34.11
