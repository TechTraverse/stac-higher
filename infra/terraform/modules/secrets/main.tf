locals {
  db_roles = {
    db_stac_higher_owner = { role = "stac_higher_owner", consumer = "app and pipeline DATABASE_URL, migrate Jobs" }
    db_stac_api          = { role = "stac_api", consumer = "stac-fastapi" }
    db_stac_reader       = { role = "stac_reader", consumer = "titiler and tipg" }
    db_stac_proxy_policy = { role = "stac_proxy_policy", consumer = "auth-proxy POLICY_DATABASE_URL" }
    db_cube_server       = { role = "cube_server", consumer = "cube-server CUBE_DB_DSN" }
  }

  tokens = {
    session_secret            = { env = "SESSION_SECRET", consumer = "app" }
    catalog_bff_shared_secret = { env = "CATALOG_BFF_SHARED_SECRET", consumer = "app and enforced auth-proxy" }
    internal_api_token        = { env = "INTERNAL_API_TOKEN", consumer = "app" }
    proxy_auth_token          = { env = "PROXY_AUTH_TOKEN", consumer = "app" }
  }

  master_key = { env = "CREDENTIALS_MASTER_KEY", consumer = "app and pipeline" }

  secrets = merge(
    {
      for k, v in local.db_roles : k => {
        name        = "${var.name_prefix}/db/${v.role}"
        description = "Login role ${v.role} (read by ${v.consumer}) for stac-higher. Generated by Terraform."
        value       = jsonencode({ username = v.role, password = random_password.db[k].result })
      }
    },
    {
      for k, v in local.tokens : k => {
        name        = "${var.name_prefix}/platform/${k}"
        description = "${v.env} for stac-higher (${v.consumer}). Generated by Terraform."
        value       = random_password.token[k].result
      }
    },
    {
      credentials_master_key = {
        name        = "${var.name_prefix}/platform/credentials_master_key"
        description = "${local.master_key.env} for stac-higher (${local.master_key.consumer}). Generated by Terraform."
        value       = random_bytes.credentials_master_key.base64
      }
    },
  )
}

resource "random_password" "db" {
  for_each = local.db_roles

  length  = 48
  special = false
}

resource "random_password" "token" {
  for_each = local.tokens

  length  = 64
  special = false
}

resource "random_bytes" "credentials_master_key" {
  length = 32
}

resource "aws_secretsmanager_secret" "this" {
  for_each = local.secrets

  name                    = each.value.name
  description             = each.value.description
  kms_key_id              = var.kms_key_arn
  recovery_window_in_days = var.recovery_window_in_days
  tags                    = var.tags
}

resource "aws_secretsmanager_secret_version" "this" {
  for_each = local.secrets

  secret_id     = aws_secretsmanager_secret.this[each.key].id
  secret_string = each.value.value
}
