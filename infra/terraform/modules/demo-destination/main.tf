data "aws_partition" "current" {}
data "aws_region" "current" {}

locals {
  bucket_name = "${var.name_prefix}-${var.name}"
  # Built the way the storage module builds it, so the policy is known at plan.
  bucket_arn = "arn:${data.aws_partition.current.partition}:s3:::${local.bucket_name}"

  user_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "DestinationWrite"
        Effect   = "Allow"
        Action   = ["s3:PutObject", "s3:AbortMultipartUpload"]
        Resource = ["${local.bucket_arn}/*"]
      },
      {
        Sid      = "DestinationList"
        Effect   = "Allow"
        Action   = ["s3:ListBucket"]
        Resource = [local.bucket_arn]
      },
      {
        Sid      = "DestinationKms"
        Effect   = "Allow"
        Action   = ["kms:GenerateDataKey", "kms:Decrypt"]
        Resource = [var.kms_key_arn]
        Condition = {
          StringEquals = {
            "kms:ViaService" = "s3.${data.aws_region.current.region}.${data.aws_partition.current.dns_suffix}"
          }
        }
      },
    ]
  })
}

module "bucket" {
  source = "../storage"

  name_prefix          = var.name_prefix
  tags                 = var.tags
  name                 = var.name
  kms_key_arn          = var.kms_key_arn
  cors_allowed_origins = []
  force_destroy        = var.force_destroy
}

resource "aws_iam_user" "this" {
  name = local.bucket_name
  path = "/stac-higher/"
  tags = var.tags
}

# Write-only by design: no Get, no Delete. Delivery's server-side copy then
# fails and falls back to streaming, as the S3 adapter documents.
resource "aws_iam_user_policy" "this" {
  name   = "write-demo-destination"
  user   = aws_iam_user.this.name
  policy = local.user_policy
}

# The key and its secret sit in Terraform state (accepted for a test target).
resource "aws_iam_access_key" "this" {
  user = aws_iam_user.this.name
}

resource "aws_secretsmanager_secret" "this" {
  name                    = "${var.name_prefix}/demo/destination_credentials"
  description             = "Access key of the write-only demo delivery destination user. Generated by Terraform."
  kms_key_id              = var.kms_key_arn
  recovery_window_in_days = var.recovery_window_in_days
  tags                    = var.tags
}

resource "aws_secretsmanager_secret_version" "this" {
  secret_id = aws_secretsmanager_secret.this.id
  secret_string = jsonencode({
    access_key_id     = aws_iam_access_key.this.id
    secret_access_key = aws_iam_access_key.this.secret
  })
}
