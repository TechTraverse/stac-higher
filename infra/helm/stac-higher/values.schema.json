{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "global": {
      "type": "object",
      "properties": {
        "imageRepository": {
          "type": "string",
          "minLength": 1
        },
        "imageTag": {
          "type": "string"
        },
        "imageDigests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "imageRegistry": {
          "type": "string"
        }
      }
    },
    "registry": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "mirrorPrefixes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "aws": {
      "type": "object",
      "properties": {
        "partition": {
          "type": "string"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "kmsKeyArn": {
          "type": "string"
        },
        "processRunRoleArn": {
          "type": "string",
          "minLength": 1
        },
        "processMaxCredentialSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 900
        },
        "s3PrefixListCidrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "bucket",
        "processRunRoleArn"
      ]
    },
    "publicUrls": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        },
        "objectStore": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        },
        "catalog": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        },
        "titiler": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        },
        "tipg": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        },
        "cubeServer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        }
      },
      "additionalProperties": false,
      "required": [
        "app",
        "objectStore",
        "catalog",
        "titiler",
        "tipg",
        "cubeServer"
      ]
    },
    "objectStore": {
      "type": "object",
      "properties": {
        "forcePathStyle": {
          "type": "boolean"
        },
        "internalEndpoint": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "masterSecretArn": {
          "type": "string"
        },
        "caCertIdentifier": {
          "type": "string"
        },
        "sslMode": {
          "enum": [
            "verify-full",
            "disable"
          ]
        },
        "caBundle": {
          "type": "object",
          "properties": {
            "existingConfigMap": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "pem": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "name"
      ]
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "oidc",
            "bypass"
          ]
        },
        "allowDevBypass": {
          "type": "boolean"
        },
        "issuer": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "issuerInternal": {
          "type": "string"
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audienceClaim": {
          "enum": [
            "aud",
            "client_id"
          ]
        },
        "claimsMapping": {
          "type": [
            "object",
            "null"
          ]
        },
        "hostedDomain": {
          "type": "string"
        },
        "devIdentity": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "pod-identity",
            "irsa"
          ]
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "serviceAccounts": {
          "type": "object",
          "properties": {
            "app": {
              "type": "string",
              "minLength": 1
            },
            "pipeline": {
              "type": "string",
              "minLength": 1
            },
            "titiler": {
              "type": "string",
              "minLength": 1
            },
            "cubeServer": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "roleArns": {
          "type": "object",
          "properties": {
            "app": {
              "type": "string"
            },
            "pipeline": {
              "type": "string"
            },
            "titiler": {
              "type": "string"
            },
            "cubeServer": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "external-secrets",
            "existing"
          ]
        },
        "arns": {
          "type": "object",
          "properties": {
            "db_stac_higher_owner": {
              "type": "string"
            },
            "db_stac_api": {
              "type": "string"
            },
            "db_stac_reader": {
              "type": "string"
            },
            "db_stac_proxy_policy": {
              "type": "string"
            },
            "db_cube_server": {
              "type": "string"
            },
            "session_secret": {
              "type": "string"
            },
            "catalog_bff_shared_secret": {
              "type": "string"
            },
            "internal_api_token": {
              "type": "string"
            },
            "credentials_master_key": {
              "type": "string"
            },
            "proxy_auth_token": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "dockerHubArn": {
          "type": "string"
        },
        "externalSecrets": {
          "type": "object",
          "properties": {
            "storeRef": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "ClusterSecretStore",
                    "SecretStore"
                  ]
                }
              }
            },
            "refreshInterval": {
              "type": "string"
            }
          }
        },
        "existing": {
          "type": "object",
          "properties": {
            "platform": {
              "type": "string"
            },
            "dbMaster": {
              "type": "string"
            },
            "dbOwner": {
              "type": "string"
            },
            "dbStacApi": {
              "type": "string"
            },
            "dbStacReader": {
              "type": "string"
            },
            "dbProxyPolicy": {
              "type": "string"
            },
            "dbCubeServer": {
              "type": "string"
            },
            "dockerHub": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "demoDestination": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "credentialsSecretArn": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "processRuns": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "createNamespace": {
          "type": "boolean"
        },
        "networkMax": {
          "type": "string"
        },
        "credentialGraceSeconds": {
          "type": "integer"
        },
        "extractMaxRunning": {
          "type": "integer",
          "minimum": 1
        },
        "clusterObjects": {
          "type": "boolean"
        },
        "defaultFamily": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,44}[a-z0-9])?$"
        },
        "profileFamilies": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,44}[a-z0-9])?$"
          }
        },
        "families": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9]([-a-z0-9]{0,44}[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "dedicatedNodes": {
                "type": "boolean"
              },
              "extraTaints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 316,
                      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$"
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 63,
                      "pattern": "^([A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?)?$"
                    },
                    "effect": {
                      "type": "string",
                      "enum": [
                        "NoSchedule",
                        "NoExecute"
                      ]
                    }
                  },
                  "required": [
                    "key",
                    "effect"
                  ],
                  "additionalProperties": false
                }
              },
              "gpuResource": {
                "type": "string",
                "pattern": "^$|^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[a-z0-9]([-a-z0-9_.]*[a-z0-9])?$"
              },
              "runtimeClass": {
                "type": "string",
                "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              },
              "quota": {
                "type": "object",
                "properties": {
                  "cpu": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "memoryGi": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "gpus": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "cpu",
                  "memoryGi"
                ],
                "additionalProperties": false
              },
              "nodePool": {
                "type": "object",
                "properties": {
                  "requirements": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 316,
                          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$"
                        },
                        "operator": {
                          "type": "string",
                          "enum": [
                            "In",
                            "NotIn",
                            "Exists",
                            "DoesNotExist",
                            "Gt",
                            "Lt"
                          ]
                        },
                        "values": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "minValues": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "key",
                        "operator"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "headroom": {
                    "type": "object",
                    "properties": {
                      "cpu": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "memoryGi": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "network": {
          "type": "object",
          "properties": {
            "dns": {
              "type": "array",
              "items": {
                "type": "object",
                "oneOf": [
                  {
                    "properties": {
                      "ipBlock": {
                        "type": "object",
                        "properties": {
                          "cidr": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "cidr"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "ipBlock"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "namespaceSelector": {
                        "type": "object",
                        "properties": {
                          "matchLabels": {
                            "type": "object",
                            "minProperties": 1,
                            "additionalProperties": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "matchLabels"
                        ],
                        "additionalProperties": false
                      },
                      "podSelector": {
                        "type": "object",
                        "properties": {
                          "matchLabels": {
                            "type": "object",
                            "minProperties": 1,
                            "additionalProperties": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "matchLabels"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "namespaceSelector",
                      "podSelector"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "objectStore": {
              "type": "array",
              "items": {
                "type": "object",
                "oneOf": [
                  {
                    "properties": {
                      "ipBlock": {
                        "type": "object",
                        "properties": {
                          "cidr": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "cidr"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "ipBlock"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "namespaceSelector": {
                        "type": "object",
                        "properties": {
                          "matchLabels": {
                            "type": "object",
                            "minProperties": 1,
                            "additionalProperties": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "matchLabels"
                        ],
                        "additionalProperties": false
                      },
                      "podSelector": {
                        "type": "object",
                        "properties": {
                          "matchLabels": {
                            "type": "object",
                            "minProperties": 1,
                            "additionalProperties": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "matchLabels"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "namespaceSelector",
                      "podSelector"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "objectStorePorts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "scannerEgressExcept": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
              }
            },
            "scannerPrivateCidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
              }
            }
          },
          "additionalProperties": false
        },
        "nodes": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "consolidateAfter": {
              "type": "string",
              "pattern": "^([0-9]+(s|m|h))+$"
            },
            "expireAfterHours": {
              "type": "integer",
              "minimum": 1
            },
            "terminationGracePeriodHours": {
              "type": "integer",
              "minimum": 1
            },
            "nodeClass": {
              "type": "object",
              "properties": {
                "create": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                },
                "role": {
                  "type": "string"
                },
                "subnetSelectorTerms": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "securityGroupSelectorTerms": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "networkPolicy": {
                  "type": "string",
                  "enum": [
                    "DefaultAllow",
                    "DefaultDeny"
                  ]
                },
                "networkPolicyEventLogs": {
                  "type": "string",
                  "enum": [
                    "Disabled",
                    "Enabled"
                  ]
                },
                "podPidsLimit": {
                  "type": "integer",
                  "anyOf": [
                    {
                      "const": -1
                    },
                    {
                      "minimum": 100
                    }
                  ]
                },
                "ephemeralStorage": {
                  "type": "object"
                },
                "tags": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "hardwareProfiles": {
          "type": [
            "object",
            "null"
          ]
        },
        "imagePolicy": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "tlsSecretName": {
          "type": "string"
        },
        "app": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object"
            }
          }
        },
        "catalog": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object"
            },
            "tlsSecretName": {
              "type": "string"
            }
          }
        },
        "titiler": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object"
            },
            "tlsSecretName": {
              "type": "string"
            }
          }
        },
        "tipg": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object"
            },
            "tlsSecretName": {
              "type": "string"
            }
          }
        },
        "cubeServer": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object"
            },
            "tlsSecretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "appIngressFrom": {
          "type": [
            "array",
            "null"
          ]
        },
        "metricsFrom": {
          "type": "array"
        },
        "publicIngressFrom": {
          "type": [
            "array",
            "null"
          ]
        }
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer"
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer"
            },
            "maxReplicas": {
              "type": "integer"
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer"
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "builtinCatalogInternalUrl": {
          "type": "string"
        },
        "safeFetchAllowHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "pipeline": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "egressAllowHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "metrics": {
          "type": "object",
          "properties": {
            "serviceMonitor": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "interval": {
                  "type": "string"
                },
                "labels": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "properties": {
        "stacApi": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 0
            },
            "resources": {
              "type": "object",
              "properties": {
                "requests": {
                  "type": "object"
                },
                "limits": {
                  "type": "object"
                }
              }
