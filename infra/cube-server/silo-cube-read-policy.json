{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCubeRepositories",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::stac-higher/assets/*/_cube/*"]
    },
    {
      "Sid": "ListCubeRepositories",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::stac-higher"],
      "Condition": { "StringLike": { "s3:prefix": ["assets/*/_cube/*"] } }
    }
  ]
}
